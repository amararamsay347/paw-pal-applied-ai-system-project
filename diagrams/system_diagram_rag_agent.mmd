---
title: PawPal+ System Diagram - Agent + RAG + Validation (matches the code)
---
flowchart TD
    %% Every box maps to a real file. Blue = original PawPal+ code, green = AI layer added in Project 4,
    %% purple = automated validation / testing, orange = human checkpoint, grey = stored data and logs.

    %% ───────────── 1. INPUT ─────────────
    subgraph INPUT["1. INPUT"]
        direction TB
        OWNER(["Pet owner"])
        UI["Streamlit UI - app.py<br/>owner, pet and task forms<br/>AI Plan Assistant: date + optional request<br/>e.g. Plan Max's day"]
        DATA[("data.json<br/>Owner.load_from_json")]
        OWNER --> UI
        DATA --> UI
    end

    KB[("Knowledge base - kb/*.md<br/>feeding, medication, exercise,<br/>grooming, vet_visits")]

    %% ───────────── 2. PROCESS ─────────────
    subgraph PROCESS["2. PROCESS - PlanningAgent.run in agent.py"]
        direction TB
        S1["Step 1 PLAN<br/>pick pets named in the request,<br/>otherwise all pets"]
        S2["Step 2 ACT - scheduler tools<br/>Scheduler.build_daily_schedule<br/>Scheduler.conflict_warnings<br/>pawpal_system.py"]
        S3["Step 3 RETRIEVE - retriever.py<br/>TF-IDF keyword search over paragraph chunks<br/>query = task name, plus the request<br/>top 2 hits, score cutoff 0.1<br/>each hit keeps its source file"]
        S4["Step 4 EXPLAIN<br/>write a cited explanation per task"]
        EXPL{"Explainer<br/>ANTHROPIC_API_KEY set?"}
        MOCK["MockExplainer<br/>offline, rule-based"]
        CLAUDE["ClaudeExplainer<br/>Claude API, JSON reply"]
        S1 --> S2 --> S3 --> S4 --> EXPL
        EXPL -->|no| MOCK
        EXPL -->|yes| CLAUDE
    end

    %% ───────────── 3. VALIDATION ─────────────
    subgraph VALID["3. VALIDATION - validators.py plus coverage check in agent.py"]
        direction TB
        V["validate_plan<br/>rules: task ids exist, on this day, pending, inside availability, none missing<br/>grounding: every citation was actually retrieved<br/>safety: dose-changing advice is an error, medication or vet items flag needs_human<br/>overlaps and uncited text are warnings"]
        PASS{"Any errors?"}
        RETRY["Retry EXPLAIN with the error text as feedback<br/>up to max_retries = 2 more attempts"]
        FALL["Step 6 FALLBACK<br/>plain Scheduler.explain_choice text,<br/>no AI-written content"]
        V --> PASS
        PASS -->|yes, attempts left| RETRY
        PASS -->|yes, attempts used up| FALL
    end

    %% ───────────── HUMAN ─────────────
    HUMAN{{"HUMAN CHECKPOINT - app.py<br/>owner reads the plan, citations, warnings<br/>and the medication or vet notice<br/>Approve or Reject<br/>Approve is disabled while errors remain"}}

    %% ───────────── 4. OUTPUT ─────────────
    subgraph OUTPUT["4. OUTPUT"]
        direction TB
        PLANOUT["Cited daily plan shown in Streamlit<br/>explainer name, attempts, fallback flag,<br/>agent reasoning trace"]
        LOGMD[("ai_interactions.md<br/>reasoning trace per run<br/>and the human decision")]
        LOGTXT[("pawpal.log<br/>agent and validator log lines")]
    end

    %% ───────────── TESTING ─────────────
    subgraph TEST["TESTING AND EVALUATION"]
        direction TB
        T1["pytest - 87 passing<br/>test_pawpal.py scheduler<br/>test_retriever.py<br/>test_validators.py<br/>test_agent.py with fake explainers"]
        T2["eval_retrieval.py<br/>12 labelled questions, hit rate<br/>6 of 6 direct, 2 of 6 paraphrased<br/>writes eval_failures.log"]
        T3["demo_guardrails.py<br/>5 bad or safe plans through the validators"]
        T4["demo_agent.py<br/>3 end-to-end runs: normal,<br/>retry, fallback - last two use an injected fault"]
    end

    %% ───────────── MAIN FLOW ─────────────
    UI -->|"owner, pets, tasks, day, request"| S1
    DATA -.-> S2
    KB -->|"read and split into paragraphs when the agent is created"| S3
    MOCK --> V
    CLAUDE --> V
    RETRY --> S4
    PASS -->|no| HUMAN
    FALL --> HUMAN
    HUMAN -->|approve or reject| PLANOUT
    PLANOUT --> UI

    %% ───────────── LOGGING ─────────────
    S1 -.->|trace| LOGMD
    S3 -.->|trace| LOGMD
    V -.->|trace| LOGMD
    HUMAN -.->|decision| LOGMD
    V -.-> LOGTXT
    S4 -.-> LOGTXT

    %% ───────────── TEST LINKS ─────────────
    T1 -.->|verifies| S2
    T1 -.->|verifies| V
    T1 -.->|verifies| S4
    T2 -.->|measures| S3
    T3 -.->|exercises| V
    T4 -.->|runs| S1

    %% ───────────── STYLES ─────────────
    classDef existing fill:#dbeafe,stroke:#1d4ed8,color:#0f172a
    classDef newcomp fill:#dcfce7,stroke:#15803d,color:#0f172a
    classDef valid fill:#ede9fe,stroke:#6d28d9,color:#0f172a
    classDef human fill:#ffedd5,stroke:#c2410c,stroke-width:3px,color:#0f172a
    classDef store fill:#f1f5f9,stroke:#475569,color:#0f172a

    class OWNER,UI,S2,PLANOUT existing
    class S1,S3,S4,EXPL,MOCK,CLAUDE,RETRY,FALL newcomp
    class V,PASS,T1,T2,T3,T4 valid
    class HUMAN human
    class DATA,KB,LOGMD,LOGTXT store
